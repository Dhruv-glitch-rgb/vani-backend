rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'official.vani.xai76@gmail.com';
    }

    match /users/{userId} {
      // Users can only read and write their own document, admin can read/write all
      allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      
      // Users can only read and write their own chat sub-collections
      match /chats/{chatId} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      }
    }
    
    match /premium_requests/{requestId} {
      // Any authenticated user can create a request for themselves
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }
    
    match /activation_keys/{keyId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.resource.data.isUsed == true && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }
    
    match /logs/{logId} {
      // Anyone authenticated can create a log, but only admin can read them
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }
  }
}
