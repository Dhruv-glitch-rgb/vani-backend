rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read on users collection so QR code verification can authenticate real users
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow pairing sessions for Quantum Beam BoVxAi-OTPC instant handshake
    match /bovxai_otpc_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Allow visitors to submit contact messages and direct inquiries
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }

    // Allow reading activation keys for redemption
    match /activation_keys/{keyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow creating premium requests even before full auth sync
    match /premium_requests/{reqId} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }

    // Allow read/write access to all other collections for authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
