{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Vary",
            "value": "Accept, Accept-Encoding"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "/openapi.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/api/openapi.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/openapi.yaml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/yaml; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/api/openapi.yaml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/yaml; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/llms.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/llms-full.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/**/*.md",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/markdown; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Vary",
            "value": "Accept, Accept-Encoding"
          }
        ]
      },
      {
        "source": "/.well-known/mcp.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/.well-known/mcp",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/agent-instructions.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/quantum_search",
        "destination": "/quantum_radar.html"
      },
      {
        "source": "/quantum-search",
        "destination": "/quantum_radar.html"
      },
      {
        "source": "/quantum_radar",
        "destination": "/quantum_radar.html"
      },
      {
        "source": "/quantum_connect",
        "destination": "/quantum_connect.html"
      },
      {
        "source": "/quantum-connect",
        "destination": "/quantum_connect.html"
      },
      {
        "source": "/saras_web_search",
        "destination": "/saras_web_search.html"
      },
      {
        "source": "/saras_vani_search",
        "destination": "/saras_vani_search.html"
      },
      {
        "source": "/saras_vani_chat",
        "destination": "/saras_vani_chat.html"
      },
      {
        "source": "/connect-with-us",
        "destination": "/connect-with-us.html"
      },
      {
        "source": "/ai4consol",
        "destination": "/ai4consol.html"
      },
      {
        "source": "/ai4consol/**",
        "destination": "/ai4consol.html"
      },
      {
        "source": "/auth-vani-xai",
        "destination": "/auth-vani-xai.html"
      },
      {
        "source": "/ai4",
        "destination": "/ai4.html"
      },
      {
        "source": "/ai4/**",
        "destination": "/ai4.html"
      },
      {
        "source": "/*/blocked-by-vani-xai0419",
        "destination": "/blocked.html"
      },
      {
        "source": "/*/banned-by-vani-xai0419",
        "destination": "/banned.html"
      }
    ]
  }
}
